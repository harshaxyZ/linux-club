NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email. Every configured channel joins a round-robin rotation, so
# one provider being down, IP-blocked or out of quota does not stop delivery.
# At least one channel is required for OTP sign-in and notifications.

# One Resend key, or several comma-separated (each is its own channel, so you get
# independent accounts and quotas).
RESEND_API_KEY=re_placeholder_api_key
RESEND_API_KEYS=re_first_key,re_second_key
# Per-key sender, positionally matched to RESEND_API_KEYS. Each Resend account
# only verifies its own domain, so key 1 may only send as @yourdomain.example
# while key 2 may only send as @otherdomain.example. Falls back to EMAIL_FROM.
RESEND_FROMS=Club <no-reply@yourdomain.example>,Club <no-reply@otherdomain.example>

# SMTP2GO (or any SMTP server). Ports: 2525 default alternative, 587/8025/80/25
# STARTTLS, 465/8465/443 implicit TLS. Never commit these values.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=your-smtp2go-username
SMTP_PASSWORD=your-smtp2go-password
# Optional: use a different From for SMTP only, e.g. when the domain verified in
# SMTP2GO is not the one in EMAIL_FROM.
SMTP_FROM=

BREVO_API_KEY=xkeysib-placeholder
# Brevo restricts sending by server IP, which serverless egress breaks often.
BREVO_SENDER_EMAIL=noreply@yourdomain.example
# Optional: pin one channel to be tried first. Accepts a kind (resend | smtp |
# brevo) or an exact channel id (resend#2). Empty means pure round-robin.
PRIMARY_EMAIL_PROVIDER=
EMAIL_FROM=Linux OSS Club <onboarding@resend.dev>
# Alternative to EMAIL_FROM, matching what the Resend dashboard gives you. Used
# only when EMAIL_FROM is empty. Do not wrap values in quotes: dotenv strips them
# locally but hosting dashboards do not, and Resend rejects a quoted From with
# 422 "Invalid `from` field" (the code strips them defensively).
FROM_NAME=
FROM_EMAIL=

# Comma-separated allowlist. These users can access /admin after signing in.
# Example: ADMIN_EMAILS=lead@dbit.edu,core2@dbit.edu
ADMIN_EMAILS=admin@example.com
# Legacy single-admin var (still honoured as fallback)
ADMIN_EMAIL=

NEXT_PUBLIC_APP_URL=https://webuildnow.in
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/AC276UE4NF
NEXT_PUBLIC_GITHUB_URL=https://github.com/LOSSC-DBIT
